# Linux 构建镜像：提供 GTK/WebKit/libpcap CGO 依赖 + Go 1.26 + Wails CLI
# apt / Go 二进制 / Go 模块均走国内镜像（阿里云 + goproxy.cn），加速构建
FROM ubuntu:22.04

# apt 源替换为阿里云镜像
RUN sed -i 's@archive.ubuntu.com@mirrors.aliyun.com@g; s@security.ubuntu.com@mirrors.aliyun.com@g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-dev libwebkit2gtk-4.1-dev libpcap-dev \
    git ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# 安装 Go 1.26（阿里云镜像，ubuntu 22.04 自带版本过旧）
RUN curl -fsSL https://mirrors.aliyun.com/golang/go1.26.0.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH=/usr/local/go/bin:$PATH GOPATH=/root/go

# Go 模块走 goproxy.cn 加速
ENV GOPROXY=https://goproxy.cn,direct GOSUMDB=sum.golang.google.cn

# 安装 Wails CLI v2.14.0（与 CI 一致）
RUN go install github.com/wailsapp/wails/v2/cmd/wails@v2.14.0
ENV PATH=$PATH:/root/go/bin

WORKDIR /build
ENTRYPOINT ["wails"]
